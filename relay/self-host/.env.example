# Copy to .env (self-host/.gitignore keeps it out of git) and fill in.

# `openssl rand -base64 48`. At least 32 characters. Changing it signs every device out.
SESSION_SECRET=

# Sign-in without GitHub: one shared key, one account for everyone who has it.
# `openssl rand -base64 32`. At least 32 characters. Each computer enters it once when it signs in.
# Changing it only affects new sign-ins; computers already signed in stay signed in.
ACCESS_KEY=

# Optional, for sign-in with GitHub as well (or instead of ACCESS_KEY). Needs internet access to
# github.com from this server and from every computer. An OAuth App with "Enable Device Flow" ticked.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The name or IP address clients use, e.g. relay.home.lan or 192.168.1.10. It must be one of the
# names given to make-certs.sh (or match your own certificate).
RELAY_HOST=

# A folder holding fullchain.pem and privkey.pem. ./make-certs.sh <RELAY_HOST> makes ./certs.
CERT_DIR=./certs

# Host port for HTTPS. Anything other than 443 must be part of the relay URL: https://host:8443
HTTPS_PORT=443
